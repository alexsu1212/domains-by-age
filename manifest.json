{
  "manifest_version": 3,
  "name": "Domains by Age",
  "version": "1.0.0",
  "description": "List every domain on the current page with its registration date, newest first.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Domains by Age",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "host_permissions": ["https://whois.freeaiapi.xyz/*"]
}
